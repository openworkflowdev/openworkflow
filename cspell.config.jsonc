{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",

  "useGitignore": true,
  "files": ["**/*.{ts,tsx,js,jsx,cjs,mjs,md,mdx,json,jsonc,yaml,yml}"],
  "ignorePaths": ["cspell.config.jsonc"],

  "flagWords": [
    // prefer en-US spellings
    // https://www.grammarly.com/blog/commonly-confused-words/canceled-vs-cancelled
    "cancelled", // prefer 'canceled'
    "cancelation", // prefer 'cancellation'
    "cancelling", // prefer 'canceling'
    "cancellable", // prefer 'cancelable'
    "canceller", // prefer 'canceler'
    "uncancelled", // prefer 'uncanceled'
  ],
  "ignoreWords": [
    // libraries & packages
    "arktype",
    "bullmq",
    "bunx",
    "inngest",
    "Mintlify",
    "nypm",
    "openworkflow",
    "oxlint",
    "pghero",
    "posthog",
    "trivago",
    "tsgolint",

    // SQL
    "hashtextextended",
    "indexrelid",
    "indisvalid",
    "mydb",
    "nspname",
    "plpgsql",
    "randomblob",
    "recordset",
    "relname",
    "relnamespace",
    "schemaname",
    "sslmode",
    "timestamptz",
    "xact",

    // project vocabulary
    "checkin",
    "checkpointing",
    "convo",
    "heartbeating",
    "idempotently",
    "Kolkata",
    "llms",
    "unaliased",
    "wakeups",

    // usernames & contributor names
    "Andres6936",
    "arloives",
    "cfelegy",
    "cliftonc",
    "dmmulroy",
    "joeruello",
    "kunaldevxxx",
    "mariusflorescu",
    "Nagpal",
    "nathancahill",
    "octoper",
    "Shobhit",
    "szokeptr",
    "thomasjiangcy",
    "vudc",
  ],
}
